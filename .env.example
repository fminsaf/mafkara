# Application
APP_URL=http://localhost:3000
NODE_ENV=development

# Supabase PostgreSQL
# Use the Supabase session/transaction pooler URL for application runtime.
DATABASE_URL=
# Prefer Supabase's direct connection URL for migrations when available.
MIGRATION_DATABASE_URL=

# Better Auth (generate with: openssl rand -base64 32)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Resend (verify the sender domain before sending mail)
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# OpenRouter (used in the conversational designer phase)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_FALLBACK_MODEL=

# Optional error monitoring
SENTRY_DSN=
